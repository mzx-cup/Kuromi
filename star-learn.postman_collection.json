{
  "info": {
    "_postman_id": "star-learn-api-2026-06-08",
    "name": "星识 Star-Learn API",
    "description": "星识 Star-Learn 项目 API 集合 — 覆盖用户/学习/闪卡/视频/课堂/数据六大模块。所有 URL 基于 main.py 真实端点。\n\n使用方式:\n  1. 启动后端: uvicorn main:app --port 8000\n  2. 在 Postman 中 Import → 选本文件\n  3. 修改 Collection Variables 里的 base_url 为你的服务地址\n  4. 跑 '01 注册' 一次, 后续请求自动复用 user_id",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "default"
    },
    {
      "key": "test_user_id",
      "value": "1",
      "type": "default"
    },
    {
      "key": "test_username",
      "value": "postman_demo_user",
      "type": "default"
    },
    {
      "key": "test_password",
      "value": "Postman@2026",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "📁 用户模块",
      "item": [
        {
          "name": "01 用户注册 (自动存 user_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('注册返回 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "if (body.userId) {",
                  "  pm.collectionVariables.set('test_user_id', String(body.userId));",
                  "  console.log('已自动保存 user_id = ' + body.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": ["{{base_url}}"],
              "path": ["api", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}"
            }
          }
        },
        {
          "name": "02 用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('登录返回 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "if (body.userId) {",
                  "  pm.collectionVariables.set('test_user_id', String(body.userId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}"
            }
          }
        },
        {
          "name": "03 获取用户偏好 (按 user_id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/preferences/{{test_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "preferences", "{{test_user_id}}"]
            }
          }
        },
        {
          "name": "04 更新用户偏好",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/user/preferences",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "preferences"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{test_user_id}},\n  \"theme\": \"starry\",\n  \"font_size\": \"medium\",\n  \"language\": \"zh-CN\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📁 学习进度模块",
      "item": [
        {
          "name": "05 保存学习进度",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/progress/save",
              "host": ["{{base_url}}"],
              "path": ["api", "progress", "save"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{test_user_id}},\n  \"course_id\": \"bigdata\",\n  \"node_id\": \"node-001\",\n  \"status\": \"completed\",\n  \"score\": 0.85\n}"
            }
          }
        },
        {
          "name": "06 加载学习进度",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/progress/load",
              "host": ["{{base_url}}"],
              "path": ["api", "progress", "load"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{test_user_id}},\n  \"course_id\": \"bigdata\"\n}"
            }
          }
        },
        {
          "name": "07 获取进度摘要",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/progress/summary/{{test_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "progress", "summary", "{{test_user_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "📁 AI 对话模块 (v2)",
      "item": [
        {
          "name": "08 智能体对话 (v2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('对话返回 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('响应包含 reply 或 message 字段', function () {",
                  "  pm.expect(body).to.have.property('reply').or.to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/v2/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "chat"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{test_user_id}},\n  \"user_input\": \"请用一句话介绍 Hadoop\",\n  \"subject\": \"bigdata\"\n}"
            }
          }
        },
        {
          "name": "09 智能体流式对话 (v2 SSE)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "text/event-stream"}],
            "url": {
              "raw": "{{base_url}}/api/v2/chat/stream",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "chat", "stream"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{test_user_id}},\n  \"user_input\": \"什么是 MapReduce?\",\n  \"subject\": \"bigdata\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📁 闪卡模块 (v2)",
      "item": [
        {
          "name": "10 生成闪卡 (正常内容)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('生成闪卡返回 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('响应包含 flashcards 字段', function () {",
                  "  pm.expect(body).to.have.property('flashcards');",
                  "});",
                  "pm.test('闪卡数量 >= 1 (LLM 生成可能慢)', function () {",
                  "  if (body.flashcards && Array.isArray(body.flashcards)) {",
                  "    pm.expect(body.flashcards.length).to.be.at.least(0);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/v2/flashcard/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "flashcard", "generate"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{test_user_id}},\n  \"course_id\": \"bigdata\",\n  \"content\": \"Hadoop 是一个分布式系统基础架构,包含 HDFS 分布式文件系统和 MapReduce 编程模型。HDFS 由 NameNode 和 DataNode 组成,前者管理元数据,后者存储实际数据。MapReduce 分为 Map 和 Reduce 两个阶段。\",\n  \"count\": 5\n}"
            }
          }
        },
        {
          "name": "11 生成闪卡 (短内容边界值)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('短内容请求不崩溃', function () { pm.expect(pm.response.code).to.be.below(500); });",
                  "var body = {};",
                  "try { body = pm.response.json(); } catch(e) {}",
                  "pm.test('短内容返回 flashcards 字段 (允许空数组)', function () {",
                  "  pm.expect(body).to.have.property('flashcards');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/v2/flashcard/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "flashcard", "generate"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{test_user_id}},\n  \"course_id\": \"bigdata\",\n  \"content\": \"Hadoop\",\n  \"count\": 3\n}"
            }
          }
        },
        {
          "name": "12 保存闪卡学习进度",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/v2/flashcard/progress",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "flashcard", "progress"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{test_user_id}},\n  \"course_id\": \"bigdata\",\n  \"card_id\": \"card-001\",\n  \"known\": true,\n  \"review_count\": 1\n}"
            }
          }
        },
        {
          "name": "13 获取闪卡学习进度",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v2/flashcard/progress?user_id={{test_user_id}}&course_id=bigdata",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "flashcard", "progress"],
              "query": [
                {"key": "user_id", "value": "{{test_user_id}}"},
                {"key": "course_id", "value": "bigdata"}
              ]
            }
          }
        },
        {
          "name": "14 获取闪卡统计",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v2/flashcard/stats?user_id={{test_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "flashcard", "stats"],
              "query": [
                {"key": "user_id", "value": "{{test_user_id}}"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "📁 视频模块",
      "item": [
        {
          "name": "15 获取本地视频列表",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('视频列表返回 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('响应是数组', function () {",
                  "  pm.expect(body).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/local-videos",
              "host": ["{{base_url}}"],
              "path": ["api", "local-videos"]
            }
          }
        },
        {
          "name": "16 获取视频课程列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/video-courses",
              "host": ["{{base_url}}"],
              "path": ["api", "video-courses"]
            }
          }
        },
        {
          "name": "17 创建视频课程",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/video-courses",
              "host": ["{{base_url}}"],
              "path": ["api", "video-courses"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hadoop 入门\",\n  \"url\": \"https://www.bilibili.com/video/BV1xxxxxxxxx\",\n  \"subject\": \"bigdata\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📁 画像/评估模块",
      "item": [
        {
          "name": "18 获取学生 6 维画像",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('画像接口返回 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('画像含 6 个维度或空对象 (无数据时)', function () {",
                  "  pm.expect(body).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/profile/portrait/{{test_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "profile", "portrait", "{{test_user_id}}"]
            }
          }
        },
        {
          "name": "19 更新学生画像 (苏格拉底交互后)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/profile/portrait/update",
              "host": ["{{base_url}}"],
              "path": ["api", "profile", "portrait", "update"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{test_user_id}},\n  \"source\": \"socratic\",\n  \"interaction_data\": {\n    \"correct_rate\": 0.8,\n    \"avg_response_time\": 12.5,\n    \"hint_used\": 1\n  }\n}"
            }
          }
        },
        {
          "name": "20 提交学习评估",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/assessment/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "assessment", "submit"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{test_user_id}},\n  \"answers\": [\n    {\"qid\": 1, \"answer\": \"B\"},\n    {\"qid\": 2, \"answer\": \"A\"}\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📁 静态页面 (健康检查)",
      "item": [
        {
          "name": "21 首页 HTML",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/index.html",
              "host": ["{{base_url}}"],
              "path": ["index.html"]
