# ============================================================================
# 星识 (Star-Learn) 环境变量配置模板
# 复制本文件为 .env 并填入实际值：
#     cp config/.env.example config/.env
# 注意：
#   1. 不要把 .env 提交到 Git（已在 .gitignore 中忽略）
#   2. 生产环境请使用强密码并设置 chmod 600
#   3. 必填项标记 [必填]，其余使用默认值即可
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# 应用 / 调试
# ────────────────────────────────────────────────────────────────────────────
# [可选] 数据库后端：sqlite / mysql / auto（默认 auto 自动检测）
STARLEARN_DB_BACKEND=sqlite
# [可选] 调试模式：True / False（开发时设为 True）
APP_DEBUG=False
# [可选] 与 APP_DEBUG 同义，规避全局 DEBUG 变量冲突
KUROMI_DEBUG=False
# [可选] 自定义 .env 路径（仅打包安装器使用）
# STARLEARN_USER_ENV=

# ────────────────────────────────────────────────────────────────────────────
# 数据库（DATABASE_URL 不填则默认使用本地 SQLite：xingshi_v2.db）
# ────────────────────────────────────────────────────────────────────────────
# [可选] 主数据库（SQLAlchemy 异步 URL）
#   - SQLite:  sqlite+aiosqlite:///./xingshi_v2.db
#   - MySQL:   mysql+aiomysql://user:password@host:3306/xingshi
#   - 留空则使用 SQLite 默认值
# DATABASE_URL=  （留空则默认 SQLite：sqlite+aiosqlite:///./xingshi_v2.db）
# [可选] 同步版本（Alembic 用，自动从 DATABASE_URL 推断）
# DATABASE_URL_SYNC=
# [可选] LangGraph 检查点数据库
# CHECKPOINT_DB_URL=

# ────────────────────────────────────────────────────────────────────────────
# 讯飞（Xunfei）大模型 API
# ────────────────────────────────────────────────────────────────────────────
# [可选] 讯飞 Chat Completions 端点
XUNFEI_API_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2/chat/completions
# [必填] 讯飞 API Key（获取：https://console.xfyun.cn/）
XUNFEI_API_KEY=your_xunfei_api_key_here
# [可选] 讯飞模型名
MODEL_NAME=astron-code-latest

# ────────────────────────────────────────────────────────────────────────────
# MiniMax API（项目当前默认使用的 LLM / 媒体服务）
# ────────────────────────────────────────────────────────────────────────────
# [可选] MiniMax API 端点
MINIMAX_API_URL=https://api.minimax.chat/v1
# [必填] MiniMax API Key
MINIMAX_API_KEY=your_minimax_api_key_here
# [必填] MiniMax Group ID（TTS 与媒体生成需要）
MINIMAX_GROUP_ID=your_minimax_group_id_here
# [可选] LLM 模型名
MINIMAX_MODEL_NAME=MiniMax-Text-01
# [可选] 图片生成模型
MINIMAX_IMAGE_MODEL=image-01
# [可选] 视频生成模型
MINIMAX_VIDEO_MODEL=video-01
# [可选] TTS 语音合成模型
MINIMAX_TTS_MODEL=speech-2.8-hd

# ────────────────────────────────────────────────────────────────────────────
# 百度语音识别（ASR）— 可选
# ────────────────────────────────────────────────────────────────────────────
# [可选] 百度 ASR App ID
BAIDU_ASR_APP_ID=your_baidu_app_id_here
# [可选] 百度 ASR API Key
BAIDU_ASR_API_KEY=your_baidu_api_key_here
# [可选] 百度 ASR Secret Key
BAIDU_ASR_SECRET_KEY=your_baidu_secret_key_here

# ────────────────────────────────────────────────────────────────────────────
# 可灵（Kling）视频生成 API — 可选
# ────────────────────────────────────────────────────────────────────────────
# [可选] 可灵 API 端点
KLING_API_URL=https://api.kling.ai/v1
# [可选] 可灵 Access Key
KLING_ACCESS_KEY=your_kling_access_key_here
# [可选] 可灵 Secret Key
KLING_SECRET_KEY=your_kling_secret_key_here

# ────────────────────────────────────────────────────────────────────────────
# 知识中台（KB）— Qdrant 向量库 + Redis 缓存
# ────────────────────────────────────────────────────────────────────────────
# [可选] Qdrant Master 节点
KB_QDRANT_MASTER_HOST=localhost
# [可选] Qdrant Replica 节点
KB_QDRANT_REPLICA_HOST=localhost
# [可选] Qdrant 端口
KB_QDRANT_PORT=6333
# [可选] Redis 主机
KB_REDIS_HOST=localhost
# [可选] Redis 端口
KB_REDIS_PORT=6379
# [可选] 健康检查间隔（秒）
KB_HEALTH_CHECK_INTERVAL_S=10
# [可选] Agent 行为日志 spool 目录（相对 cwd）
KB_BEHAVIOR_LOG_SPOOL_DIR=./spool/agent_log
# [可选] LangChain 路径灰度切流比例（0-100）
KB_READ_BACKEND_PERCENTAGE=0
# [可选] 是否双写旧版路径
KB_DUAL_WRITE_LEGACY=True

# ────────────────────────────────────────────────────────────────────────────
# Navicat 脚本数据库连接（仅 python Navicat/setup_database.py 使用）
# ────────────────────────────────────────────────────────────────────────────
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=starlearn
# MYSQL_PASSWORD=your_mysql_password_here

# ────────────────────────────────────────────────────────────────────────────
# 学习路径目标真实性校验
# ────────────────────────────────────────────────────────────────────────────
# [可选] JSON 格式：
# {"enabled": true, "strict": false, "max_invalid_pct": 50.0}
# LEARNING_GOAL_VALIDATION=

# ────────────────────────────────────────────────────────────────────────────
# JWT 签名密钥（启动期校验，长度必须 >= 32 字节）
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
# ────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me

# ============================================================================
# 检查清单（部署前确认）：
#   [ ] XUNFEI_API_KEY 已填（运行讯飞模型时需要）
#   [ ] MINIMAX_API_KEY / MINIMAX_GROUP_ID 已填（默认使用 MiniMax）
#   [ ] JWT_SECRET 已替换为非占位值 (长度 >= 32, 非 change-me)
#   [ ] MySQL 用户的 GRANT 包含 xingshi.*
#   [ ] DATABASE_URL 已切换为 MySQL（如使用 MySQL）
#   [ ] 生产环境 APP_DEBUG=False
# ============================================================================
JWT_SECRET=k9Xv2mQ7rT4wZ8nB3cL6pH1jF5sD0gA9uE2yK7xM4qW6
