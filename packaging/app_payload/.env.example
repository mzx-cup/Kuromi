# ============================================================================
# 星识 (Star-Learn) 环境变量配置模板（项目根目录）
#
# 注意：项目优先读取 config/.env，但部分工具（如 Alembic、Docker Compose）
# 会从项目根 .env 读取。两个文件保持一致即可。
# 复制本文件为 .env 并填入实际值：
#     cp .env.example .env
# ============================================================================

# ─── 应用 ───
APP_DEBUG=False
KUROMI_DEBUG=False

# ─── 数据库（默认 SQLite；如需 MySQL 请修改） ───
# DATABASE_URL=mysql+aiomysql://starlearn:password@127.0.0.1:3306/xingshi
# DATABASE_URL_SYNC=mysql+pymysql://starlearn:password@127.0.0.1:3306/xingshi
# CHECKPOINT_DB_URL=mysql+pymysql://starlearn:password@127.0.0.1:3306/xingshi

# ─── LLM API（必填） ───
XUNFEI_API_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2/chat/completions
XUNFEI_API_KEY=your_xunfei_api_key_here
MODEL_NAME=astron-code-latest

MINIMAX_API_URL=https://api.minimax.chat/v1
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here
MINIMAX_MODEL_NAME=MiniMax-Text-01

# ─── 媒体 API（可选） ───
# BAIDU_ASR_APP_ID=
# BAIDU_ASR_API_KEY=
# BAIDU_ASR_SECRET_KEY=
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=

# ─── 知识中台 ───
KB_QDRANT_MASTER_HOST=localhost
KB_QDRANT_REPLICA_HOST=localhost
KB_QDRANT_PORT=6333
KB_REDIS_HOST=localhost
KB_REDIS_PORT=6379