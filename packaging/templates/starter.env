# Star-Learn (星识) — first-run configuration template.
# This file is copied to %APPDATA%\StarLearn\.env on first launch.
# Edit values below and restart the app to apply.

# ---- Database (do not change unless you know what you are doing) ----
STARLEARN_DB_BACKEND=sqlite
SQLITE_PATH={DB_FILE}
DATABASE_URL=sqlite+aiosqlite:///{DB_FILE_URL}

# ---- 讯飞 (Xunfei) 大模型 API ----
# Get a key at: https://console.xfyun.cn/
# XUNFEI_API_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2/chat/completions
# XUNFEI_API_KEY=
# MODEL_NAME=astron-code-latest

# ---- MiniMax (mm) 大模型 + TTS + 媒体生成 ----
# MINIMAX_API_URL=https://api.minimax.chat/v1
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=

# ---- 百度语音识别 (ASR) ----
# BAIDU_ASR_API_KEY=
# BAIDU_ASR_SECRET_KEY=

# ---- 可灵 (Kling) 视频生成 ----
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=

# ---- App ----
APP_DEBUG=False
