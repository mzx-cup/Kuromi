{
  "courseId": "course_1777808559_137f5481",
  "title": "Redis核心实战",
  "outlines": [
    {
      "id": 1,
      "title": "Redis核心概念解析",
      "type": "slide",
      "points": 3,
      "key_points": [
        "Redis单线程模型的高效执行原理",
        "IO多路复用机制的底层实现逻辑",
        "Redis五种基础数据结构的应用场景"
      ],
      "description": "通过可视化图表深入讲解Redis的C/S架构、单线程模型与IO多路复用机制，建立理论基础。"
    },
    {
      "id": 2,
      "title": "基础数据结构实战",
      "type": "code",
      "points": 3,
      "key_points": [
        "String类型的SET/GET与原子计数操作",
        "List结构实现简单消息队列的LPUSH/RPOP",
        "Set集合的交集并集运算与去重应用"
      ],
      "description": "在在线IDE中实操String、List、Set等基础命令，通过实战演练掌握数据的增删改查操作。"
    },
    {
      "id": 3,
      "title": "内存数据结构原理",
      "type": "interactive",
      "points": 3,
      "key_points": [
        "Hash表的渐进式Rehash扩容机制",
        "ZSet跳跃表的层级索引构建原理",
        "不同数据结构底层编码的转换条件"
      ],
      "description": "通过交互式可视化模拟，动态调整参数观察Hash表扩容与ZSet跳跃表节点的插入过程。"
    },
    {
      "id": 4,
      "title": "核心机制知识测验",
      "type": "quiz",
      "points": 3,
      "key_points": [
        "定期删除与惰性删除的配合策略",
        "LRU/LFU等八种内存淘汰算法区别",
        "RDB快照与AOF日志的优缺点对比"
      ],
      "description": "针对过期策略、内存淘汰机制及持久化原理进行随堂测验，检验关键知识点的掌握程度。"
    },
    {
      "id": 5,
      "title": "高并发缓存架构图解",
      "type": "diagram",
      "points": 3,
      "key_points": [
        "缓存穿透的布隆过滤器与空值缓存方案",
        "缓存击穿的互斥锁与逻辑过期方案",
        "缓存雪崩的随机过期时间与多级缓存"
      ],
      "description": "展示缓存穿透、击穿、雪崩的架构原理图，并标注解决方案在系统架构中的具体位置。"
    },
    {
      "id": 6,
      "title": "分布式锁实现",
      "type": "exercise",
      "points": 3,
      "key_points": [
        "使用SETNX命令实现分布式锁获取",
        "Lua脚本保证解锁操作的原子性",
        "锁过期时间与看门狗自动续期机制"
      ],
      "description": "模拟电商秒杀场景，引导学员逐步完善setnx加锁、解锁逻辑，解决超卖与死锁问题。"
    },
    {
      "id": 7,
      "title": "社交平台项目实战",
      "type": "pbl",
      "points": 3,
      "key_points": [
        "使用Set集合实现点赞与共同关注功能",
        "利用ZSet实现最新动态的时间线排序",
        "BitMap结构在用户签到统计中的应用"
      ],
      "description": "基于Redis设计并实现一个社交平台的点赞、共同好友关注及消息推送功能模块。"
    }
  ],
