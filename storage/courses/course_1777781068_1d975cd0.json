{
  "courseId": "course_1777781068_1d975cd0",
  "title": "Java零基础入门",
  "outlines": [
    {
      "id": 1,
      "title": "Java开发环境搭建",
      "type": "slide",
      "points": 3,
      "key_points": [
        "理解Java跨平台原理与JVM机制",
        "掌握JDK下载安装与环境变量配置",
        "编写并运行第一个Java程序"
      ],
      "description": "介绍Java语言特性、JVM架构原理，演示JDK安装配置及HelloWorld程序编写流程。"
    },
    {
      "id": 2,
      "title": "变量与数据类型",
      "type": "interactive",
      "points": 3,
      "key_points": [
        "掌握八种基本数据类型及其取值范围",
        "理解变量声明、初始化与作用域",
        "区分自动类型转换与强制类型转换"
      ],
      "description": "通过可视化交互界面，模拟变量声明与赋值过程，直观理解内存中数据存储变化。"
    },
    {
      "id": 3,
      "title": "流程控制语句",
      "type": "code",
      "points": 3,
      "key_points": [
        "掌握if-else条件判断语句结构",
        "熟练使用for循环与while循环",
        "理解break与continue关键字用法"
      ],
      "description": "在IDE环境中练习if-else条件分支与for/while循环结构，解决具体逻辑问题。"
    },
    {
      "id": 4,
      "title": "基础语法综合测验",
      "type": "quiz",
      "points": 3,
      "key_points": [
        "考察数据类型转换规则与潜在风险",
        "验证运算符优先级与结合性理解",
        "测试循环嵌套逻辑与条件判断能力"
      ],
      "description": "针对变量类型、运算符优先级及流程控制逻辑进行测试，评估基础阶段学习效果。"
    },
    {
      "id": 5,
      "title": "面向对象核心概念",
      "type": "diagram",
      "points": 3,
      "key_points": [
        "理解类与对象的关系及构造方法",
        "掌握封装通过访问修饰符实现",
        "理解继承关系与方法重写机制"
      ],
      "description": "利用UML类图展示类与对象关系，解析封装、继承、多态三大特性的实现原理。"
    },
    {
      "id": 6,
      "title": "核心API实战应用",
      "type": "exercise",
      "points": 3,
      "key_points": [
        "熟练使用String类常用方法处理文本",
        "掌握ArrayList集合的增删改查操作",
        "使用LocalDate处理日期时间数据"
      ],
      "description": "编写代码处理字符串操作、集合遍历与日期格式化，解决常见数据处理需求。"
    },
    {
      "id": 7,
      "title": "开发学生管理系统",
      "type": "pbl",
      "points": 3,
      "key_points": [
        "运用面向对象思想进行系统架构设计",
        "实现集合框架存储与管理学生数据",
        "整合输入输出流实现数据持久化"
      ],
      "description": "综合运用面向对象编程思想，设计并实现一个具备增删改查功能的学生信息管理系统。"
    }
  ],
