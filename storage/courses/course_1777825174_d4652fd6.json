{
  "courseId": "course_1777825174_d4652fd6",
  "title": "C指针核心精讲",
  "outlines": [
    {
      "id": 1,
      "title": "指针的本质解析",
      "type": "slide",
      "points": 3,
      "key_points": [
        "理解内存地址与指针变量的对应关系",
        "掌握指针变量的声明与初始化语法",
        "区分指针变量与普通变量的本质差异"
      ],
      "description": "通过内存地址示意图，深入浅出地讲解指针变量的定义、声明及其存储地址的本质特性。"
    },
    {
      "id": 2,
      "title": "内存寻址可视化",
      "type": "interactive",
      "points": 3,
      "key_points": [
        "可视化展示变量在内存中的地址分配",
        "交互式演示指针指向变量的过程",
        "理解解引用操作符访问内存数据"
      ],
      "description": "利用可视化模拟工具，直观展示变量在内存中的布局，以及指针指向特定内存地址的过程。"
    },
    {
      "id": 3,
      "title": "指针核心概念测验",
      "type": "quiz",
      "points": 3,
      "key_points": [
        "识别正确的指针声明与初始化语法",
        "判断指针变量当前的指向关系",
        "分析指针解引用后的数据类型"
      ],
      "description": "针对指针声明、初始化及基本操作设计选择题，检验学习者对指针基础概念的理解程度。"
    },
    {
      "id": 4,
      "title": "指针运算规则",
      "type": "diagram",
      "points": 3,
      "key_points": [
        "掌握指针加减整数时的地址偏移量",
        "理解数据类型大小对指针步长的影响",
        "建立指针运算与数组遍历的联系"
      ],
      "description": "通过图表展示指针加减运算与数组下标的关系，详细说明不同数据类型指针的步长差异。"
    },
    {
      "id": 5,
      "title": "指针与数组实战",
      "type": "code",
      "points": 3,
      "key_points": [
        "使用指针遍历一维数组元素",
        "通过指针算术运算访问数组元素",
        "理解数组名作为指针常量的用法"
      ],
      "description": "在集成开发环境中编写代码，练习使用指针遍历数组元素，体会指针访问的高效性。"
    },
    {
      "id": 6,
      "title": "函数值传递困境",
      "type": "pbl",
      "points": 3,
      "key_points": [
        "分析函数值传递无法修改实参的原因",
        "使用指针参数实现函数内外数据共享",
        "理解引用传递与指针传递的关系"
      ],
      "description": "设计一个交换两个变量值的函数场景，解决普通值传递无法修改实参的问题，探究指针作为参数的作用。"
    },
    {
      "id": 7,
      "title": "指针与内存管理",
      "type": "video",
      "points": 3,
      "key_points": [
        "掌握动态内存申请与释放的标准流程",
        "识别并避免常见的内存泄漏错误",
        "理解悬空指针产生的原因及危害"
      ],
      "description": "观看动态内存分配演示视频，学习malloc与free的正确使用方法，预防内存泄漏风险。"
    }
  ],
